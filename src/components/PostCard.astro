---
import { t } from '@/lib/i18n';
import Icon from './Icon.astro';

interface Props {
  post: {
    id: string;
    slug: string;
    body: string;
    collection: string;
    data: {
      title: string;
      description: string;
      date: Date;
      updatedDate?: Date;
      heroImage?: string;
    };
  };
}

const { post } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const date = post.data.date.toLocaleDateString(locale === 'es' ? 'es-MX' : 'en-US', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<article onclick={`window.location.href='${locale === 'es' ? '/es' : ''}/posts/${post.slug}'`}
  class="p-4 md:p-5 bg-slate-800/40 border border-white/5 rounded-lg hover:border-cyan-500/40 hover:bg-slate-800/80 transition-colors transition-opacity transition-transform duration-300 group cursor-pointer">
  <div class="font-mono text-xs text-slate-500 mb-2 flex justify-between items-center">
    <span>SYS.LOG // {date}</span>
    <span
      class="text-hud-cyan opacity-0 -translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-colors transition-opacity transition-transform duration-300 font-bold tracking-wider">
      &lt;{t(locale, 'read_status')}&gt;
    </span>
  </div>
  <h4
    class="text-lg font-semibold text-slate-200 group-hover:text-cyan-400 transition-colors mb-2 leading-tight flex items-start gap-2">
    <span class="material-symbols-outlined text-lg opacity-40 shrink-0 mt-0.5">&#xe86f;</span>
    {post.data.title}
  </h4>
  <div class="text-sm text-slate-400 line-clamp-2 ml-7">
    {post.data.description}
  </div>
</article>

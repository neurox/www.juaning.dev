---
import { getRelativeLocaleUrl } from 'astro:i18n';
const currentPath = Astro.url.pathname;
const locale = Astro.currentLocale ?? 'en';
const otherLocale = locale === 'en' ? 'es' : 'en';
const basePath = currentPath.replace(/^\/(es)?/, '') || '/';
const otherPath = getRelativeLocaleUrl(otherLocale, basePath);
---

<div class="flex items-center gap-2 text-sm font-mono uppercase tracking-wider">
  <span class:list={['font-normal', locale === 'en' ? 'text-slate-200' : 'text-slate-500 hover:text-hud-cyan transition-colors']}>
    {locale === 'en' ? <span>en</span> : <a href={otherPath}>en</a>}
  </span>
  <span class="text-slate-300 dark:text-slate-700 font-normal">|</span>
  <span class:list={[locale === 'es' ? 'text-slate-200' : 'text-slate-500 hover:text-hud-cyan transition-colors']}>
    {locale === 'es' ? <span>es</span> : <a href={otherPath}>es</a>}
  </span>
</div>

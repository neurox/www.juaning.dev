---
import Base from '@/layouts/Base.astro';
import { t } from '@/lib/i18n';

const locale = Astro.currentLocale ?? 'en';
---

<Base title="404">
  <div class="flex flex-col items-center justify-center min-h-[60vh] gap-6 text-center">
    <div class="glass-card rounded-xl p-12 flex flex-col items-center gap-6">
      <span class="material-symbols-outlined text-6xl text-hud-cyan">&#xe86f;</span>
      <h1 class="text-4xl md:text-5xl font-display font-bold text-slate-100">404</h1>
      <p class="text-slate-400 text-lg">Sorry, this page is not available.</p>
      <a href={locale === 'es' ? '/es/' : '/'}
        class="inline-flex items-center gap-2 px-6 py-3 bg-hud-cyan text-slate-950 font-bold rounded hover:bg-[#38bdf8] transition-colors">
        <span class="material-symbols-outlined">&#xe88a;</span>
        Go Home
      </a>
    </div>
  </div>
</Base>

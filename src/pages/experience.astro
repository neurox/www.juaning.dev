---
import Base from '@/layouts/Base.astro';
import { t } from '@/lib/i18n';
const locale = Astro.currentLocale ?? 'en';
const T = (key: string) => t(locale as 'en' | 'es', key);
const roles = locale === 'es' ? [
  {dates:'FEB 2024 — PRESENTE', role:'Arquitecto Senior de Backend y Cloud', company:'Consultor independiente', bullets:['Define arquitecturas para actualizaciones a Drupal 11 y PHP 8.3, estructuras multisitio, patrones de API y automatización de despliegues.','Automatiza CI/CD y procesamiento mediante colas para migraciones y registros financieros, reduciendo el trabajo manual al menos 60%.','Mejora el rendimiento de backend y bases de datos, reduciendo tiempos de respuesta aproximadamente 25%.']},
  {dates:'MAR 2025 — ENE 2026', role:'Ingeniero Senior de Software | Arquitecto Backend y Drupal', company:'weKnow Inc', bullets:['Definió estándares para una plataforma Drupal 11 multisitio que soporta más de 10 empresas y 50 divisiones.','Construyó una cola asíncrona para decenas de miles de transacciones, reduciendo 70% la conciliación manual.','Lideró actualizaciones a PHP 8.3 y optimización de rendimiento en portales de división.']},
  {dates:'MAR 2019 — ENE 2024', role:'Desarrollador Full Stack e Ingeniero Cloud', company:'D4ALL', bullets:['Construyó nueve portales Drupal 10 para LACCD sobre Acquia Cloud, atendiendo miles de usuarios diarios.','Creó una migración sin downtime para más de 20,000 usuarios de Curtiss-Wright.','Estandarizó Docker, DDEV, CI/CD y Canary Releases con rollback rápido.']},
  {dates:'MAY 2016 — DIC 2018', role:'Desarrollador Web Full Stack', company:'Wirefin', bullets:['Desarrolló aplicaciones PHP y JavaScript, modelos relacionales e integraciones API.','Realizó soporte de producción, hardening, auditorías preventivas y resolución de incidentes.']},
] : [
  {dates:'FEB 2024 — PRESENT', role:'Senior Backend & Cloud Architect', company:'Independent Consultant', bullets:['Sets architecture for Drupal 11 and PHP 8.3 upgrades, multisite structures, API patterns, and deployment automation.','Automates CI/CD and queue-driven processing for migrations and financial records, cutting manual work by at least 60%.','Improves backend and database performance, reducing server response times by approximately 25%.']},
  {dates:'MAR 2025 — JAN 2026', role:'Senior Software Engineer | Backend & Drupal Architect', company:'weKnow Inc', bullets:['Set standards for a Drupal 11 multisite platform supporting 10+ companies and 50+ divisions.','Built an asynchronous queue for tens of thousands of transactions, reducing manual reconciliation by 70%.','Led PHP 8.3 upgrades and performance tuning across division portals.']},
  {dates:'MAR 2019 — JAN 2024', role:'Full Stack Web Developer & Cloud Engineer', company:'D4ALL', bullets:['Built nine Drupal 10 production portals for LACCD on Acquia Cloud, serving thousands of daily users.','Created a zero-downtime migration pipeline for 20,000+ Curtiss-Wright user records.','Standardized Docker, DDEV, CI/CD, and Canary Release workflows with rapid rollback.']},
  {dates:'MAY 2016 — DEC 2018', role:'Full Stack Web Developer', company:'Wirefin', bullets:['Built PHP and JavaScript applications, relational data models, and API integrations.','Handled production support, security hardening, preventive audits, and troubleshooting.']},
];
---
<Base title={T('nav_experience')} description={T('experience_meta')}><section class="section-block"><header class="page-heading"><div class="eyebrow"><span></span>{T('experience_kicker')}</div><h1>{T('experience_page_title')}</h1><p>{T('experience_page_intro')}</p></header><div class="experience-list">{roles.map(role => <article class="experience-item"><div class="font-mono text-xs tracking-[0.12em] text-hud-cyan">{role.dates}</div><div><span class="case-tag">{role.company}</span><h2>{role.role}</h2><ul>{role.bullets.map(bullet => <li>{bullet}</li>)}</ul></div></article>)}</div><div class="cta-shell"><div><h2>{T('experience_cta')}</h2><p>{T('experience_cta_desc')}</p></div><a class="button-primary" href="/pdf/juan-gomez-cv.pdf" target="_blank">{T('btn_download_cv')}</a></div></section></Base>

---
import Base from '@/layouts/Base.astro';
import { t } from '@/lib/i18n';
import { getCollection } from 'astro:content';
import PostCard from '@/components/PostCard.astro';
import Icon from '@/components/Icon.astro';

const locale = Astro.currentLocale ?? 'en';
const posts = (await getCollection('posts'))
  .filter(p => p.id.startsWith(`${locale}/`))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title={t(locale, 'Posts')} description={t(locale, 'articles_recent_desc')}>
  <div class="flex flex-col gap-8 md:gap-10">
    <header class="glass-card rounded-xl p-8 border-l-[3px] border-l-hud-cyan relative overflow-hidden group">
      <div class="absolute -top-10 -right-10 p-4 opacity-[0.03] pointer-events-none">
        <span class="material-symbols-outlined text-[200px] text-hud-cyan">&#xe2c8;</span>
      </div>
      <h1 class="font-display text-3xl md:text-4xl font-bold leading-tight tracking-tight capitalize text-slate-100 relative z-10 flex items-center gap-4">
        <div class="flex items-center justify-center w-12 h-12 md:w-14 md:h-14 rounded-lg bg-hud-cyan/10 border border-hud-cyan/20 text-hud-cyan shrink-0">
          <Icon name="folder" class="text-3xl md:text-4xl" />
        </div>
        {t(locale, 'Posts')}
      </h1>
      <div class="text-slate-400 text-lg max-w-2xl mt-4 relative z-10 font-sans">
        {t(locale, 'articles_recent_desc')}
      </div>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map(post => (
        <article class="glass-card rounded-xl p-6 hover:border-hud-cyan/50 hover:-translate-y-1 transition-colors transition-opacity transition-transform duration-300 group cursor-pointer flex flex-col h-full"
          onclick={`window.location.href='${locale === 'es' ? '/es' : ''}/posts/${post.slug}'`}>
          <div class="font-mono text-xs text-slate-500 mb-3 flex justify-between items-center">
            <span>{post.data.date.toLocaleDateString(locale === 'es' ? 'es-MX' : 'en-US', { year: 'numeric', month: '2-digit', day: '2-digit' })}</span>
            <span class="text-hud-cyan opacity-0 group-hover:opacity-100 transition-opacity tracking-wider">&lt;open&gt;</span>
          </div>
          <h2 class="font-display text-xl font-bold leading-tight text-slate-200 group-hover:text-hud-cyan transition-colors mb-3">
            {post.data.title}
          </h2>
          <div class="text-sm text-slate-400 line-clamp-3">
            {post.data.description}
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>

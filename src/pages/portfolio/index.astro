---
import Base from '@/layouts/Base.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '@/lib/i18n';
import { getCollection } from 'astro:content';
import Icon from '@/components/Icon.astro';

const locale = Astro.currentLocale ?? 'en';
const portfolio = (await getCollection('portfolio'))
  .filter(p => p.id.startsWith(`${locale}/`))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map(item => ({
    ...item,
    url: getRelativeLocaleUrl(locale, `portfolio/${item.slug.split('/').slice(1).join('/')}`),
  }));
---

<Base title={t(locale, 'btn_view_portfolio')} description={t(locale, 'section_expertise_desc')}>
  <div class="section-block">
    <header class="page-heading">
      <div class="eyebrow"><span></span>{t(locale, 'work_kicker')}</div>
      <h1>{t(locale, 'selected_work_title')}</h1>
      <p>{t(locale, 'section_expertise_desc')}</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
      {portfolio.map(item => (
        <a class="case-card group" href={item.url}><div class="flex items-center justify-between"><span class="case-tag">{item.data.category}</span><Icon name={item.data.icon ?? 'work'} class="text-xl text-slate-600" /></div><div class="case-metric">{item.data.metric}</div><h2 class="mt-5 font-display text-2xl font-bold text-white">{item.data.title}</h2><p class="mt-4 text-sm leading-relaxed text-slate-400">{item.data.description}</p><span class="mt-auto pt-6 text-sm font-semibold text-hud-cyan">{t(locale, 'case_read')} &rarr;</span></a>
      ))}
    </div>
  </div>
</Base>

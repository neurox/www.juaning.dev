---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import ContactForm from '@/components/ContactForm';
import { t } from '@/lib/i18n';
const locale = Astro.currentLocale ?? 'en';
const T = (key: string) => t(locale as 'en' | 'es', key);
---

<Base title={T('nav_contact')} description={T('contact_meta')}>
  <section class="section-block">
    <header class="page-heading relative overflow-hidden">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="relative z-10 max-w-4xl">
        <div class="eyebrow"><span></span>{T('contact_kicker')}</div>
        <h1>{T('contact_page_title')}</h1>
        <p>{T('contact_page_intro')}</p>
      </div>
    </header>

    <div class="grid gap-6 lg:grid-cols-[0.72fr_1.28fr]">
      <aside class="flex flex-col gap-5">
        <div class="content-panel">
          <div class="eyebrow"><span></span>{T('contact_fit_kicker')}</div>
          <h2 class="mt-4 font-display text-2xl font-bold text-white">{T('contact_fit_title')}</h2>
          <ul class="mt-6 space-y-4">
            {['contact_fit_arch', 'contact_fit_modern', 'contact_fit_cloud', 'contact_fit_delivery'].map((key) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-slate-300"><Icon name="arrow_outward" class="mt-0.5 text-base text-hud-cyan" /><span>{T(key)}</span></li>
            ))}
          </ul>
        </div>

        <a class="content-panel group block transition-colors hover:border-hud-cyan/40" href="mailto:juanjose@ingomez.com">
          <div class="flex items-center justify-between gap-4"><div><span class="font-mono text-[10px] uppercase tracking-[0.15em] text-slate-500">{T('contact_form_email')}</span><strong class="mt-2 block break-all text-base text-white group-hover:text-hud-cyan">juanjose@ingomez.com</strong></div><Icon name="mail" class="text-2xl text-hud-cyan" /></div>
        </a>

        <div class="content-panel">
          <div class="flex items-center gap-3"><span class="relative flex h-2.5 w-2.5"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-50"></span><span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-400"></span></span><span class="font-mono text-xs uppercase tracking-[0.12em] text-emerald-300">{T('contact_status')}</span></div>
          <p class="mt-4 text-sm leading-relaxed text-slate-400">{T('contact_response')}</p>
        </div>
      </aside>

      <ContactForm client:load locale={locale} />
    </div>
  </section>
</Base>

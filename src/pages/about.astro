---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { t } from '@/lib/i18n';
import { Image } from 'astro:assets';
import profileImg from '@/assets/images/profile.jpg';
const locale = Astro.currentLocale ?? 'en';
const T = (key: string) => t(locale as 'en' | 'es', key);
---
<Base title={T('about_title')} description={T('about_meta')}>
  <article class="section-block">
    <header class="grid items-center gap-8 rounded-2xl border border-white/10 bg-slate-900/35 p-7 md:p-10 lg:grid-cols-[240px_1fr]"><Image src={profileImg} alt="Juan Gómez" width={360} height={360} class="aspect-square w-full max-w-[240px] rounded-xl object-cover ring-1 ring-white/10" /><div><div class="eyebrow"><span></span>{T('about_kicker')}</div><h1 class="mt-4 font-display text-4xl font-bold tracking-tight text-white md:text-6xl">{T('about_heading')}</h1><p class="mt-5 max-w-3xl text-lg leading-relaxed text-slate-300">{T('about_intro_plain')}</p></div></header>
    <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="content-panel prose prose-invert max-w-none prose-headings:font-display prose-a:text-hud-cyan"><h2>{T('about_scale_title')}</h2><p set:html={T('about_scale_p1')} /><p set:html={T('about_scale_p2')} /><h2>{T('about_philosophy_title')}</h2><p set:html={T('about_philosophy_p1')} /><p set:html={T('about_philosophy_p2_new')} /><h2>{T('about_leadership_title')}</h2><p set:html={T('about_leadership_p1')} /></div>
      <aside class="space-y-5"><div class="content-panel"><div class="eyebrow"><span></span>{T('about_focus')}</div><ul class="mt-5 space-y-3 text-sm text-slate-300"><li>PHP 8.x & Drupal 11</li><li>AWS & Acquia Cloud</li><li>High-availability platforms</li><li>Queue-driven architecture</li><li>Zero-downtime modernization</li></ul></div><div class="content-panel"><h2 class="font-display text-2xl font-bold text-white">{T('about_cv_title')}</h2><p class="mt-3 text-sm leading-relaxed text-slate-400">{T('about_cv_desc_new')}</p><a href="/pdf/juan-gomez-cv.pdf" target="_blank" class="button-primary mt-6"><Icon name="description" class="text-lg" /> {T('btn_download_cv')}</a></div><div class="content-panel"><h2 class="font-display text-xl font-bold text-white">{T('about_connect_title')}</h2><div class="mt-4 flex flex-col gap-3 text-sm"><a class="text-link" href="mailto:juanjose@ingomez.com">juanjose@ingomez.com</a><a class="text-link" href="https://www.linkedin.com/in/juaningdotdev" target="_blank" rel="noopener">LinkedIn</a><a class="text-link" href="https://github.com/neurox" target="_blank" rel="noopener">GitHub</a></div></div></aside>
    </div>
  </article>
</Base>
